{
  "expo": {
    "name": "PMC Portal",
    "slug": "mobile-portal",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobileportal",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pmcportal.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "PMC Portal uses your location to verify site attendance during your work shift.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PMC Portal uses your location during your work shift, including when the app is in the background, to verify site attendance and alert you if you enter a restricted zone. Tracking stops when your shift ends.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.pmcportal.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F0A227",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCmPCnsTu_zLkdBVPrY0x7-CZXEV1-ybm0"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PMC Portal uses your location during your work shift, including when the app is in the background, to verify site attendance and alert you if you enter a restricted zone. Tracking stops when your shift ends.",
          "locationWhenInUsePermission": "PMC Portal uses your location to verify site attendance during your work shift.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-lockup.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F0A227"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F0A227",
          "sounds": [
            "./assets/sounds/boundary_exit.wav",
            "./assets/sounds/redzone_entry.wav",
            "./assets/sounds/critical_alarm.wav",
            "./assets/sounds/alarm_01.wav",
            "./assets/sounds/alarm_02.wav",
            "./assets/sounds/alarm_03.wav",
            "./assets/sounds/alarm_04.wav",
            "./assets/sounds/alarm_05.wav",
            "./assets/sounds/alarm_06.wav",
            "./assets/sounds/alarm_07.wav",
            "./assets/sounds/alarm_08.wav",
            "./assets/sounds/alarm_09.wav",
            "./assets/sounds/alarm_10.wav"
          ]
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "PMC Portal needs access to your photos to attach a signed quality checklist.",
          "cameraPermission": "PMC Portal needs access to your camera to photograph a signed quality checklist."
        }
      ],
      "@sentry/react-native",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23496903-a9cc-44b2-8c89-724e265c34f1"
      }
    },
    "owner": "kabilan404"
  }
}
